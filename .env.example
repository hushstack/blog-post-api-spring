# ---------------------------------------------------------------------------
# Template. Copy to .env and fill in real values:  cp .env.example .env
# THIS file is tracked; .env is not.
# Loaded by spring.config.import in application.properties, parsed as a
# properties file. A real exported environment variable overrides anything here.
#
# Two kinds of key live in this file:
#   SHOUTY_CASE  — values the properties files already reference as ${VAR}
#   spring.*     — native Spring keys, for features switched on by PRESENCE
#                  rather than by value. Commenting one out turns the feature
#                  off; setting it to empty does NOT.
# ---------------------------------------------------------------------------

# --- Postgres -------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/db_blog_post_api_spring
DB_USERNAME=postgres
DB_PASSWORD=

# --- Redis ----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Local Redis has no auth. Uncomment only if yours requires a password —
# an empty value would still send an AUTH command and be rejected.
#spring.data.redis.password=

# --- RabbitMQ -------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- JWT ------------------------------------------------------------------
# Must be at least 32 bytes or JwtProvider refuses to start, deliberately.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- Mail -----------------------------------------------------------------
# Envelope sender, used by both the SMTP and the logging implementation.
MAIL_FROM=no-reply@localhost

# SMTP is OFF while these stay commented out: EmailConfig picks
# LoggingEmailService when no spring.mail.host exists, which prints OTP codes
# at DEBUG so registration is completable locally with no mail server.
#
# Uncomment the block to send for real. Do NOT set spring.mail.host to an
# empty value — Boot builds a JavaMailSender whenever the key is present at
# all, which selects SMTP with nowhere to connect.
#
# For Gmail this must be a 16-character App Password, not the account
# password, and the account needs 2FA enabled.
#
#spring.mail.host=smtp.gmail.com
#spring.mail.port=587
#spring.mail.username=you@gmail.com
#spring.mail.password=your-app-password
#spring.mail.properties.mail.smtp.auth=true
#spring.mail.properties.mail.smtp.starttls.enable=true
#spring.mail.properties.mail.smtp.starttls.required=true
#
# With real SMTP wired up, stop printing codes to the log:
#app.email.log-codes=false

# --- Storage / URLs -------------------------------------------------------
STORAGE_PATH=./uploads
STORAGE_PUBLIC_URL=http://localhost:8080/files
SHARE_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

